{
  "buildCommand": "pnpm run build",
  "devCommand": "pnpm run dev",
  "installCommand": "pnpm install",
  "framework": "vite",
  "env": {
    "DATABASE_URL": {
      "description": "PostgreSQL connection string for Supabase",
      "required": true
    },
    "JWT_SECRET": {
      "description": "Secret key for JWT signing",
      "required": true
    },
    "VITE_APP_ID": {
      "description": "Manus OAuth App ID",
      "required": true
    },
    "OAUTH_SERVER_URL": {
      "description": "Manus OAuth server URL",
      "required": true
    },
    "VITE_OAUTH_PORTAL_URL": {
      "description": "Manus OAuth portal URL",
      "required": true
    },
    "OWNER_NAME": {
      "description": "Owner name for notifications",
      "required": true
    },
    "OWNER_OPEN_ID": {
      "description": "Owner's Manus Open ID",
      "required": true
    },
    "BUILT_IN_FORGE_API_URL": {
      "description": "Manus Forge API URL",
      "required": true
    },
    "BUILT_IN_FORGE_API_KEY": {
      "description": "Manus Forge API Key (backend)",
      "required": true
    },
    "VITE_FRONTEND_FORGE_API_KEY": {
      "description": "Manus Forge API Key (frontend)",
      "required": true
    },
    "VITE_FRONTEND_FORGE_API_URL": {
      "description": "Manus Forge API URL (frontend)",
      "required": true
    },
    "VITE_APP_TITLE": {
      "description": "App title",
      "default": "SportConnect"
    },
    "VITE_APP_LOGO": {
      "description": "App logo path",
      "default": "/logo.png"
    },
    "VITE_ANALYTICS_ENDPOINT": {
      "description": "Analytics endpoint (optional)",
      "required": false
    },
    "VITE_ANALYTICS_WEBSITE_ID": {
      "description": "Analytics website ID (optional)",
      "required": false
    }
  },
  "regions": ["iad1"],
  "functions": {
    "api/**": {
      "maxDuration": 30
    }
  }
}
